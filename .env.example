# =============================================================================
# Theorem Health AI Receptionist — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# On Render, set these via the Environment Variables tab in the dashboard.
# =============================================================================


# =============================================================================
# Phase 3: Tool-calling LLM receptionist
# =============================================================================

# Anthropic API key (required for Phase 3)
# Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use as the main receptionist brain.
# Default: claude-sonnet-4-6  (fast, capable, recommended)
# Can be switched to: claude-opus-4-6  (slower, higher quality)
RECEPTIONIST_MODEL=claude-sonnet-4-6

# Set to "true" to enable the Phase 3 tool-calling architecture.
# When "false" (default), the legacy state-machine in triage_legacy.py is used.
# Toggle this in Render's environment variables for instant rollback.
PHASE3_ENABLED=false


# =============================================================================
# AssemblyAI (Speech-to-Text — Universal-Streaming WebSocket)
# Used by the Realtime voice pipeline (REALTIME_ENABLED=true) for STT.
# Create a key at https://www.assemblyai.com
# =============================================================================
ASSEMBLYAI_API_KEY=...

# --- Speech model selection -------------------------------------------------
# Precedence in assemblyai_ws_url() is V2 > U3.5 > default. ASSEMBLYAI_USE_V2 is
# the break-glass 8kHz fallback and WINS if set, so U3.5 silently does nothing
# while it is on. Check both before concluding a model is live.
#
# Proof of which model a call actually used is one line per call in the log:
#   [ms_stt] init — stt_variant=u3.5-pro | universal-streaming-english | v2
#
# Universal-3.5 Pro Realtime. Default OFF in code, so it must be set explicitly
# on EVERY service that wants it — a branch re-cut carries code, not config.
ASSEMBLYAI_USE_U35=false
# Undo U3.5's always-on formatting so the engine's raw-transcript matchers keep
# working (phone numbers, name wrappers). Leave true unless deliberately testing
# punctuation as a signal. Inert unless ASSEMBLYAI_USE_U35 is on.
U35_DEFORMAT=true
# Endpointing for U3.5, independent of the 600ms tuned for the older model.
U35_MIN_TURN_SILENCE=600
U35_MAX_TURN_SILENCE=1280
# Break-glass fallback to the battle-tested 8kHz v2 socket. Leave unset.
ASSEMBLYAI_USE_V2=false


# =============================================================================
# Groq (primary LLM for the Realtime voice pipeline)
# Model: meta-llama/llama-4-maverick-17b-128e-instruct  max_tokens: 150
# Create a key at https://console.groq.com
# =============================================================================
GROQ_API_KEY=gsk_...


# =============================================================================
# OpenAI (used by legacy intent classifier, smart fallback, llm_router)
# =============================================================================
OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-4o-mini if not set
OPENAI_MODEL=gpt-4o-mini


# =============================================================================
# Twilio (Voice & SMS)
# =============================================================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The Twilio number Susie answers on (must match TWILIO_TO_CLINIC in clinic_config.py)
TWILIO_PHONE_NUMBER=+447...

# Oversight relay: copies EVERY inbound text to the clinic line to this number.
# A monitoring copy only — the practitioner forward and the patient ack are
# unchanged. Unset falls back to the clinic's `sms_relay_to` config key; set it
# to an empty value to switch the relay off for this deployment.
# Requires the number's Twilio "A MESSAGE COMES IN" webhook to POST to
# <BASE_URL>/twilio/sms/inbound.
SMS_RELAY_TO=+447...


# =============================================================================
# ElevenLabs TTS (voice synthesis)
# Used by both the legacy HTTP flow and the OpenAI Realtime pipeline.
# In Realtime mode, ElevenLabs Flash v2.5 replaces the OpenAI built-in voice.
# =============================================================================
ELEVENLABS_API_KEY=...
# Voice ID for Susie — find it in your ElevenLabs voice library
# Default (kBag1HOZlaVBH7ICPE8x) is pre-configured for the Realtime pipeline
ELEVENLABS_VOICE_ID=kBag1HOZlaVBH7ICPE8x


# =============================================================================
# Redis (session storage — required in production; optional locally)
# =============================================================================
# Provide a Redis URL from Render (redis://...) or leave blank to use
# in-memory fallback (sessions won't persist across restarts)
REDIS_URL=redis://...


# =============================================================================
# Google Calendar (OAuth — per user, stored in Redis after auth flow)
# =============================================================================
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# The calendar to read/write for the demo clinic (Google Calendar mode)
# Leave as "primary" to use the authenticated user's primary calendar
DEFAULT_CALENDAR_ID=primary


# =============================================================================
# Google Service Account (for Sheets reporting — server-side only)
# =============================================================================
# Paste the full contents of your service account JSON as a single-line string,
# OR set GOOGLE_SA_FILE to the path of the JSON file (for local development)
GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# GOOGLE_SA_FILE=/path/to/service-account.json

# Google Sheets spreadsheet ID (found in the sheet URL)
GOOGLE_SHEETS_ID=1a2b3c...


# =============================================================================
# Acuity Scheduling (Theorem clinic — primary booking system)
# =============================================================================
ACUITY_USER_ID=...
ACUITY_API_KEY=...
# Calendar IDs for each location (find in Acuity → Availability → Calendars)
ACUITY_CALENDAR_ID_ALCESTER=...
ACUITY_CALENDAR_ID_REDDITCH=...
# Calendar IDs for individual practitioners
ACUITY_CALENDAR_ID_MARK=...
ACUITY_CALENDAR_ID_LEANNE=...


# =============================================================================
# Application
# =============================================================================
# Display name for the clinic — used in spoken phrases and SMS templates  # MARK_REVIEW
CLINIC_NAME=Theorem Health
# Clinic address for Google Maps link in booking confirmation SMS  # MARK_REVIEW
CLINIC_ADDRESS=123 High Street, Alcester B49 5AD
# Clinic phone number shown in booking confirmation SMS  # MARK_REVIEW
CLINIC_PHONE=01234 567890
# Public base URL (used to build Twilio callback URLs)
BASE_URL=https://your-app.onrender.com
# "dev" or "production"
ENV=production

# =============================================================================
# Barge-in detection (Media Streams pipeline)
# =============================================================================
# Minimum speech duration in ms for a barge-in to be treated as genuine.
# Speech under this threshold is treated as noise and TTS is resumed.
# Default: 300ms. Increase if false triggers occur on the line.
BARGE_IN_THRESHOLD_MS=300
# Set to "true" automatically by Render — controls some logging/fallback behaviour
RENDER=true

# TTS_BYPASS_CLINIC=theorem_v3  <- use OpenAI TTS instead of ElevenLabs for this clinic (cheaper for testing)

# =============================================================================
# End-of-day booking digest (emails the day's Google Calendar bookings so the
# agency can enter them into Carepatron — no Carepatron API exists)
# =============================================================================
# SMTP transport (works with Gmail, SendGrid, Mailgun, SES SMTP, etc.).
# If unset, the digest worker runs but emailing is a safe no-op.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password-or-api-key
SMTP_FROM=bookings@yourdomain.com
SMTP_FROM_NAME=Susie
# SMTP_USE_SSL=true   # force implicit SSL (port 465); otherwise STARTTLS on 587
# Per-deployment digest overrides (clinic.json operational.digest is the default)
# DIGEST_EMAIL_TO=bookings@clinic.co.uk   # comma-separated for multiple
# DIGEST_HOUR=21
# DIGEST_MINUTE=30
# DIGEST_ENABLED=true

# =============================================================================
# Call observability: low-score SMS + daily system email (app/obs/**)
# =============================================================================
# Additive layer — runs async AFTER a call ends. Every flag defaults OFF; with them
# off nothing is captured, judged or sent, and the live call path is untouched.
#
# 1. Capture — store completed calls in Postgres (required by everything below).
#    Provision the DB in the EU (Frankfurt) — calls are special-category health data.
OBS_CAPTURE_ENABLED=false
OBS_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
#    One-off after provisioning:  python -m app.obs.migrate
#
# 2. Judge — score each call with Claude after teardown. Needs ANTHROPIC_API_KEY.
OBS_JUDGE_ENABLED=false
# OBS_JUDGE_MODEL=claude-opus-4-8    # cheaper: claude-sonnet-5 / claude-haiku-4-5
#
# 3. Immediate operator SMS for callback-worthy calls. NOTE: this is deliberately
#    NOT every low score — a merely-clumsy call waits for the daily email, so the
#    phone only rings when someone actually needs calling back. E.164 required.
OBS_ALERTS_ENABLED=false
OBS_ALERT_SMS_TO=+447000000000
# OBS_SLACK_WEBHOOK=
#
# 4. Daily whole-system email (app/obs/worker.py — a background worker, same
#    pattern as the booking digest; no Render cron needed). Sends every day even
#    when nothing needs review, so no email = something is broken.
#    Transport reuses the SMTP_* block above (SMTP_USERNAME, not SMTP_USER).
OBS_DIGEST_ENABLED=false
OBS_DIGEST_EMAIL_TO=you@example.com
# OBS_DIGEST_HOUR=7        # London local send time (default 07:00)
# OBS_DIGEST_MINUTE=0
# OBS_DIGEST_HOURS=24      # lookback window
# Inline each review call's FULL redacted transcript in the email. Special-category
# health data — leave OFF unless the recipient is the data controller. UK GDPR.
OBS_DIGEST_INCLUDE_TRANSCRIPTS=false

# ---------------------------------------------------------------------------
# Diagnostic audio capture (app/media_streams/audio_capture.py) — BOTH OFF
# ---------------------------------------------------------------------------
# For answering ONE question: when a caller says "I said..." but the logs show
# no partial, no final and no VAD event — did their voice reach us at all?
# Server logs cannot tell a caller whose audio never left the handset from a
# caller sitting in silence. These two artefacts bracket it, and whichever is
# silent is the side that lost the audio:
#
#   TWILIO_CALL_RECORDING_ENABLED -> what TWILIO received (dual-channel:
#                                    caller on ch1, Susie on ch2, so you can
#                                    hear whether they talked over her)
#   AUDIO_CAPTURE_ENABLED         -> what THIS SERVER received (8kHz PCM16 WAV,
#                                    one file per call_sid)
#
# UK GDPR — this is a healthcare line. Recording patient calls needs a lawful
# basis, notification (normally in the greeting), a retention policy and secure
# storage. Leave BOTH false on any number a real patient can reach. They exist
# for test calls where the engineer is the only speaker, and therefore the only
# data subject. Twilio recordings are stored on Twilio and must be deleted after
# the test; WAVs stay on our own disk.
AUDIO_CAPTURE_ENABLED=false
TWILIO_CALL_RECORDING_ENABLED=false
# AUDIO_CAPTURE_DIR=logs/audio        # where the WAVs are written
# AUDIO_CAPTURE_MAX_SECONDS=600       # memory ceiling (~4.8MB); floored at 10

# ---------------------------------------------------------------------------
# SMS on the latency-eval service
# ---------------------------------------------------------------------------
# SMS_ENABLED gates EVERY outbound text — patient booking confirmations and
# reminders as well as owner alerts. It defaults false on latency-eval (and
# true-by-env on the live services) so an eval run cannot text a real patient
# if the Render variable is forgotten. See app/notifications/sms.py.
#
# Before setting SMS_ENABLED=true here, set EVAL_STAFF_SMS_TO as well. The
# eval line maps to clinic_id "jv_v1", so without it every owner alert,
# waitlist ping and staff notify goes to the practitioner's real mobile —
# once per call. EVAL_STAFF_SMS_TO redirects anything addressed to a
# configured staff number to you instead; patient-facing SMS are untouched,
# which is the point.
#
# Leave BOTH unset on any live clinic service.
# SMS_ENABLED=true
# EVAL_STAFF_SMS_TO=+447700900123     # your mobile, E.164

# ---------------------------------------------------------------------------
# Automatic appointment reminders — OFF
# ---------------------------------------------------------------------------
# The 24-hour and 2-hour reminder texts are switched off by owner decision,
# 2026-08-07. The default lives in code (app/notifications/scheduler.py), so a
# service that deploys without this variable stays silent — leave it unset.
#
# It gates the reminders only. The booking confirmation SMS, the name-
# confirmation nudge and the home-visit address nudge are unaffected and still
# send; SMS_ENABLED above remains the switch for all outbound text.
#
# Set it to true only to deliberately bring reminders back on one service.
# APPOINTMENT_REMINDERS_ENABLED=true
